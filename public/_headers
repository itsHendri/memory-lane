# Cloudflare Pages headers.
#
# Everything Astro emits under /_astro/ carries a content hash in its filename,
# so it can be cached forever — a change produces a new filename.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts used to live in public/ and were served unhashed from /fonts/*, which
# made `immutable` a promise this file had to keep by hand. They now go through
# the asset pipeline and come out content-hashed under /_astro/, so the rule
# above already covers them and a re-subset simply produces a new filename.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
