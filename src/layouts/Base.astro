---
import archivoUrl from "~/assets/fonts/archivo-700-latin.woff2"
import monoUrl from "~/assets/fonts/jetbrains-mono-var-latin.woff2"
import "~/styles/tokens.css"
import "~/styles/type.css"
import "~/styles/base.css"

interface Props {
    title?: string
    description?: string
}

/*
 * Real metadata. The original shipped the generic placeholder title and
 * description its builder emitted — they were never set — so this is free
 * ground on every audit that looks at the document head.
 *
 * The title is still open (SECTOR READ vs Return to Sender, story/beats.md).
 * It lives here and in the wordmark component only, so a swap is two files.
 */
const {
    title = "SECTOR READ",
    description = "A recovery machine reads a memory card that never arrived.",
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)

/*
 * Files in public/ are served verbatim under the deploy base, and nothing
 * rewrites them for us — astro:assets only rebases what it processes. On a
 * GitHub Pages project site the base is /memory-lane, so a bare "/favicon.svg"
 * would 404.
 *
 * The fonts are NOT in public/ for this reason. A bare "/fonts/..." in
 * type.css worked in the build (Vite rebases `url()` there) and 404'd in dev
 * (it does not), so dev fetched every face twice and warned that the preload
 * went unused. Importing them makes one URL that is correct in both, and the
 * build content-hashes them — which retires the hand-maintained promise in
 * public/_headers that their filenames would never be reused.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary_large_image" />

        <meta name="theme-color" content="#05060f" />

        {/* Without this the browser requests /favicon.ico and logs a 404. */}
        <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

        {/*
          Both faces are used above the fold — the headline and every chrome
          readout — so both preload. `crossorigin` is required even same-origin
          for fonts, or the preload is fetched twice.
        */}
        <link
            rel="preload"
            href={archivoUrl}
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href={monoUrl}
            as="font"
            type="font/woff2"
            crossorigin
        />

        <slot name="head" />
    </head>
    <body>
        <slot />
    </body>
</html>
